<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Family Memories — Family Dashboard</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              cream:   '#FFF4E8',
              peach:   '#F8DCC8',
              terra:   '#E88B61',
              terrad:  '#C8694A',
              sage:    '#536B55',
              sagel:   '#EEF4EE',
              charcoal:'#39352F',
              warmgray:'#81766C',
              teal:    '#EAF6F8',
              tealbdr: '#C8E8ED',
            },
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', '"Inter"', 'ui-sans-serif', 'system-ui', 'sans-serif'],
            },
          },
        },
      };
    </script>

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="style.css" />
  </head>

  <body class="font-sans antialiased" style="background:#F5F0EA; color:#39352F;">

    <!-- ══════════════════════════════════════════════════════
         TOAST CONTAINER
    ══════════════════════════════════════════════════════════ -->
    <div id="toastContainer"
         aria-live="polite" aria-atomic="true"
         class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none">
    </div>

    <!-- ══════════════════════════════════════════════════════
         MOBILE OVERLAY (closes sidebar)
    ══════════════════════════════════════════════════════════ -->
    <div id="sidebarOverlay"
         class="fixed inset-0 z-30 bg-black/30 hidden lg:hidden"
         aria-hidden="true">
    </div>

    <!-- ══════════════════════════════════════════════════════
         APP SHELL
    ══════════════════════════════════════════════════════════ -->
    <div class="app-shell">

      <!-- ════════════════════════════════════════════════
           SIDEBAR
      ════════════════════════════════════════════════ -->
      <aside id="sidebar" class="sidebar" aria-label="Main navigation">

        <!-- Brand -->
        <div class="sidebar-brand">
          <div class="sidebar-logo" aria-hidden="true">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.2"
                 viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 10.5L12 4l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V10.5z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 21V13h6v8"/>
            </svg>
          </div>
          <div class="leading-tight">
            <span class="block text-sm font-bold" style="color:#39352F;">Family Memories</span>
            <span class="block text-[10px]" style="color:#81766C;">Family Dashboard</span>
          </div>
        </div>

        <!-- MAIN NAV -->
        <nav class="sidebar-nav" aria-label="Primary">
          <p class="sidebar-section-label">MAIN</p>

          <button class="sidebar-item active" data-section="overview" onclick="switchSection('overview')">
            <!-- Grid icon -->
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>
            </svg>
            <span>Overview</span>
          </button>

          <button class="sidebar-item" data-section="calendar" onclick="switchSection('calendar')">
            <!-- Calendar icon -->
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>Calendar</span>
          </button>

          <button class="sidebar-item" data-section="tasks" onclick="switchSection('tasks')">
            <!-- Clipboard icon -->
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
            <span>Tasks</span>
            <span id="sidebarTaskBadge" class="sidebar-badge hidden">0</span>
          </button>

          <button class="sidebar-item" data-section="board" onclick="switchSection('board')">
            <!-- Kanban icon -->
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
            </svg>
            <span>Board</span>
          </button>
        </nav>

        <!-- HOUSEHOLD NAV -->
        <nav class="sidebar-nav mt-4" aria-label="Household">
          <p class="sidebar-section-label">HOUSEHOLD</p>

          <button class="sidebar-item" data-section="birthdays" onclick="switchSection('birthdays')">
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-1.5-.454M9 6l3-3 3 3M9 6v2m6-2v2m-3-5v5"/>
            </svg>
            <span>Birthdays</span>
          </button>

          <button class="sidebar-item" data-section="contacts" onclick="switchSection('contacts')">
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Contacts</span>
          </button>

          <button class="sidebar-item" data-section="budget" onclick="switchSection('budget')">
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Budget</span>
          </button>

          <button class="sidebar-item" data-section="documents" onclick="switchSection('documents')">
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>Documents</span>
          </button>

          <button class="sidebar-item" data-section="housekeeping" onclick="switchSection('housekeeping')">
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M3 10.5L12 4l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V10.5zM9 21V13h6v8"/>
            </svg>
            <span>Housekeeping</span>
          </button>

          <button class="sidebar-item" data-section="kitchen" onclick="switchSection('kitchen')">
            <svg class="sidebar-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Kitchen</span>
          </button>
        </nav>

        <!-- Bottom user zone -->
        <div class="sidebar-footer">
          <div class="sidebar-avatar" aria-hidden="true">👨‍👩‍👧‍👦</div>
          <div class="leading-tight min-w-0">
            <p class="text-xs font-semibold truncate" style="color:#39352F;">My Family</p>
            <p class="text-[10px]" style="color:#81766C;">family@home.com</p>
          </div>
        </div>

      </aside><!-- /sidebar -->

      <!-- ════════════════════════════════════════════════
           MAIN AREA
      ════════════════════════════════════════════════ -->
      <div class="main-area">

        <!-- TOP BAR -->
        <header class="topbar" style="background:#FFF4E8; border-bottom: 1px solid #F0D9C4;">
          <!-- Mobile hamburger -->
          <button id="sidebarToggle" class="topbar-hamburger lg:hidden" aria-label="Open menu">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>

          <!-- Page breadcrumb -->
          <div class="flex items-center gap-2 min-w-0">
            <span id="topbarTitle" class="text-sm font-bold" style="color:#39352F;">Overview</span>
          </div>

          <!-- Right actions -->
          <div class="flex items-center gap-3 ml-auto">
            <!-- Task count pill -->
            <span id="navTaskCount"
                  class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full"
                  style="background:#F8DCC8; color:#C8694A;">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
              <span id="navTaskText">0 tasks</span>
            </span>
            <!-- Date display -->
            <span id="topbarDate"
                  class="hidden md:block text-xs font-medium" style="color:#81766C;"></span>
          </div>
        </header>

        <!-- SCROLLABLE CONTENT -->
        <div class="main-content">

          <!-- ══════════════════════════════════════════════
               SECTION: OVERVIEW
          ══════════════════════════════════════════════ -->
          <section id="section-overview" class="section-page active-section">

            <!-- Welcome banner -->
            <div class="welcome-banner">
              <div>
                <p class="welcome-eyebrow">Good morning ☀️</p>
                <h1 class="welcome-title">Welcome to Your Family Space</h1>
                <p class="welcome-sub">Here's what's happening with your family today.</p>
              </div>
              <div class="welcome-illus" aria-hidden="true">
                <!-- Tiny house SVG decoration -->
                <svg width="80" height="68" viewBox="0 0 80 68" fill="none">
                  <polygon points="8,34 40,8 72,34" fill="#E88B61" opacity=".25"/>
                  <rect x="18" y="34" width="44" height="30" rx="3" fill="#E88B61" opacity=".18"/>
                  <rect x="32" y="46" width="16" height="18" rx="2" fill="#E88B61" opacity=".35"/>
                  <path d="M28 22 C26 19 21 19 21 23.5 C21 28 28 31 28 31 C28 31 35 28 35 23.5 C35 19 30 19 28 22Z"
                        fill="#E88B61" opacity=".7"/>
                </svg>
              </div>
            </div>

            <!-- STATS ROW -->
            <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-6">
              <div class="stat-card" style="border-top:4px solid #E88B61;">
                <div class="stat-icon" style="background:#FFF0E4;color:#E88B61;">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 12h6M9 16h4"/>
                  </svg>
                </div>
                <div>
                  <p id="statTotal" class="stat-number" style="color:#E88B61;">0</p>
                  <p class="stat-label">Total Tasks</p>
                </div>
              </div>
              <div class="stat-card" style="border-top:4px solid #F8DCC8;">
                <div class="stat-icon" style="background:#FEF3EC;color:#C8694A;">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <div>
                  <p id="statActive" class="stat-number" style="color:#C8694A;">0</p>
                  <p class="stat-label">Active</p>
                </div>
              </div>
              <div class="stat-card" style="border-top:4px solid #536B55;">
                <div class="stat-icon" style="background:#EEF4EE;color:#536B55;">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p id="statCompleted" class="stat-number" style="color:#536B55;">0</p>
                  <p class="stat-label">Completed</p>
                </div>
              </div>
            </div>

            <!-- TODAY AT A GLANCE -->
            <h2 class="section-heading mb-3">Today at a Glance</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-7">
              <div class="glance-card" style="--glance-color:#E88B61; --glance-bg:#FFF0E4;">
                <div class="glance-icon">
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                  </svg>
                </div>
                <p class="glance-label">Tasks</p>
                <p id="glanceTaskCount" class="glance-count">0</p>
                <p class="glance-sub">pending today</p>
              </div>
              <div class="glance-card" style="--glance-color:#C8694A; --glance-bg:#FEF3EC;">
                <div class="glance-icon">
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
                <p class="glance-label">Events</p>
                <p class="glance-count">2</p>
                <p class="glance-sub">this week</p>
              </div>
              <div class="glance-card" style="--glance-color:#536B55; --glance-bg:#EEF4EE;">
                <div class="glance-icon">
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                </div>
                <p class="glance-label">Shopping</p>
                <p class="glance-count">5</p>
                <p class="glance-sub">items listed</p>
              </div>
              <div class="glance-card" style="--glance-color:#A07050; --glance-bg:#FDF5EE;">
                <div class="glance-icon">
                  <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/>
                  </svg>
                </div>
                <p class="glance-label">Dinner</p>
                <p class="glance-count">1</p>
                <p class="glance-sub">meal planned</p>
              </div>
            </div>

            <!-- MAIN TWO-COLUMN: Tasks + Mini Calendar -->
            <h2 class="section-heading mb-3">Family Activities</h2>
            <div class="overview-cols">

              <!-- LEFT: Task panel -->
              <div class="workspace-card">
                <!-- Card header -->
                <div class="wcard-header">
                  <span class="wcard-title">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round"
                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    Tasks
                  </span>
                  <div class="flex items-center gap-2">
                    <p id="statsLabel" class="text-xs font-medium" style="color:#81766C;"></p>
                    <button class="wcard-action-btn"
                            onclick="switchSection('tasks')" title="View all tasks">
                      See all →
                    </button>
                  </div>
                </div>

                <!-- Filter pills (mini) -->
                <div class="flex gap-1.5 mb-3" role="group" aria-label="Filter tasks">
                  <button data-filter="all"       class="filter-btn filter-active">All</button>
                  <button data-filter="active"    class="filter-btn">Active</button>
                  <button data-filter="completed" class="filter-btn">Done</button>
                </div>

                <!-- Task list area -->
                <div id="taskList" aria-live="polite" class="task-list-area"></div>

                <!-- Empty state -->
                <div id="emptyState" class="hidden">
                  <div class="empty-state-inner">
                    <div class="empty-icon-wrap" style="background:#FFF0E4;">
                      <svg class="w-8 h-8" style="color:#E88B61; opacity:.6;"
                           fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 12h6M9 16h4"/>
                      </svg>
                    </div>
                    <h3 id="emptyTitle" class="text-sm font-bold mt-3" style="color:#39352F;">No Tasks Yet</h3>
                    <p id="emptyDesc" class="text-xs mt-1" style="color:#81766C;">
                      Start adding your family activities.
                    </p>
                  </div>
                </div>
              </div><!-- /task panel -->

              <!-- RIGHT: Add Task Form + Mini Calendar -->
              <div class="flex flex-col gap-4">

                <!-- Add / Edit Task Form -->
                <div class="workspace-card" id="formCard">
                  <div class="wcard-header" id="formHeaderBar" style="background:#E88B61; margin:-1.25rem -1.25rem 1rem; padding:0.75rem 1.25rem; border-radius:0.875rem 0.875rem 0 0;">
                    <span class="wcard-title" style="color:white;">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                      </svg>
                      <span id="formTitle" style="color:white;">Add New Task</span>
                    </span>
                  </div>

                  <form id="taskForm" novalidate class="space-y-3">
                    <div>
                      <label for="taskTitle" class="form-label">Task Title <span style="color:#E88B61;">*</span></label>
                      <input id="taskTitle" type="text" maxlength="80"
                             placeholder="e.g. Plan family picnic…"
                             class="form-input" autocomplete="off"/>
                      <p id="titleError" class="form-error hidden">Title is required.</p>
                    </div>
                    <div>
                      <label for="taskDesc" class="form-label">
                        Description <span class="font-normal" style="color:#ccc;">(optional)</span>
                      </label>
                      <textarea id="taskDesc" rows="2" maxlength="200"
                                placeholder="Add a note or detail…"
                                class="form-input resize-none"></textarea>
                    </div>
                    <div>
                      <label for="taskDate" class="form-label">
                        Date <span class="font-normal" style="color:#ccc;">(optional)</span>
                      </label>
                      <input id="taskDate" type="date" class="form-input"/>
                    </div>
                    <div class="flex gap-2 pt-1">
                      <button id="submitBtn" type="submit" class="btn-primary flex-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        <span id="submitLabel">Add Task</span>
                      </button>
                      <button id="cancelBtn" type="button" class="btn-ghost hidden">Cancel</button>
                    </div>
                  </form>
                </div><!-- /form card -->

                <!-- Mini Calendar Widget -->
                <div class="workspace-card">
                  <div class="wcard-header mb-2">
                    <span class="wcard-title">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      Calendar
                    </span>
                    <div class="flex items-center gap-1">
                      <button id="calPrev" class="cal-nav-btn" aria-label="Previous month">&#8249;</button>
                      <span id="calMonthLabel" class="text-xs font-semibold" style="color:#39352F;min-width:90px;text-align:center;"></span>
                      <button id="calNext" class="cal-nav-btn" aria-label="Next month">&#8250;</button>
                    </div>
                  </div>
                  <div id="miniCalendar" class="mini-calendar"></div>
                </div>

              </div><!-- /right col -->
            </div><!-- /overview-cols -->

          </section><!-- /overview -->

          <!-- ══════════════════════════════════════════════
               SECTION: TASKS (full page)
          ══════════════════════════════════════════════ -->
          <section id="section-tasks" class="section-page hidden">
            <div class="page-header">
              <div>
                <h1 class="page-title">Tasks</h1>
                <p class="page-sub">Manage and track all your family activities.</p>
              </div>
            </div>
            <div class="overview-cols">
              <!-- Form -->
              <div class="workspace-card" id="formCard2">
                <div style="background:#E88B61; margin:-1.25rem -1.25rem 1rem; padding:.75rem 1.25rem; border-radius:.875rem .875rem 0 0;">
                  <span class="wcard-title" style="color:white;">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span>Add New Task</span>
                  </span>
                </div>
                <p class="text-xs mb-3" style="color:#81766C;">Use the form in the Overview tab to add or edit tasks.</p>
                <button onclick="switchSection('overview')" class="btn-primary w-full">
                  Go to Overview
                </button>
              </div>
              <!-- Full task list -->
              <div class="workspace-card flex-1">
                <div class="wcard-header mb-3">
                  <span class="wcard-title">All Family Tasks</span>
                  <p id="statsLabel2" class="text-xs font-medium" style="color:#81766C;"></p>
                </div>
                <div class="flex gap-1.5 mb-3" role="group">
                  <button data-filter="all"       class="filter-btn filter-active filter-tasks-page">All</button>
                  <button data-filter="active"    class="filter-btn filter-tasks-page">Active</button>
                  <button data-filter="completed" class="filter-btn filter-tasks-page">Done</button>
                </div>
                <div id="taskList2" aria-live="polite" class="task-list-area"></div>
                <div id="emptyState2" class="hidden">
                  <div class="empty-state-inner">
                    <div class="empty-icon-wrap" style="background:#FFF0E4;">
                      <svg class="w-8 h-8" style="color:#E88B61;opacity:.6;" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2M9 12h6M9 16h4"/>
                      </svg>
                    </div>
                    <h3 class="text-sm font-bold mt-3" style="color:#39352F;">No Tasks Found</h3>
                    <p class="text-xs mt-1" style="color:#81766C;">Try a different filter or add a new task.</p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- ══════════════════════════════════════════════
               SECTION: CALENDAR (full page)
          ══════════════════════════════════════════════ -->
          <section id="section-calendar" class="section-page hidden">
            <div class="page-header">
              <h1 class="page-title">Calendar</h1>
              <p class="page-sub">View your family's upcoming activities by date.</p>
            </div>
            <div class="workspace-card max-w-lg mx-auto">
              <div class="wcard-header mb-3">
                <span class="wcard-title">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  Monthly View
                </span>
                <div class="flex items-center gap-1">
                  <button id="calPrev2" class="cal-nav-btn">&#8249;</button>
                  <span id="calMonthLabel2" class="text-xs font-semibold" style="color:#39352F; min-width:100px; text-align:center;"></span>
                  <button id="calNext2" class="cal-nav-btn">&#8250;</button>
                </div>
              </div>
              <div id="fullCalendar" class="mini-calendar"></div>
              <div id="calTasksForDay" class="mt-4 space-y-2 hidden">
                <h4 id="calDayTitle" class="text-xs font-bold mb-2" style="color:#39352F;"></h4>
              </div>
            </div>
          </section>

          <!-- ══════════════════════════════════════════════
               SECTION: BOARD
          ══════════════════════════════════════════════ -->
          <section id="section-board" class="section-page hidden">
            <div class="page-header">
              <h1 class="page-title">Board</h1>
              <p class="page-sub">Visualise your tasks in a Kanban-style board.</p>
            </div>
            <div class="board-columns">
              <div class="board-col">
                <div class="board-col-header" style="border-top-color:#E88B61;">
                  <span class="board-col-dot" style="background:#E88B61;"></span>
                  <span class="board-col-title">To Do</span>
                  <span id="boardTodoCount" class="board-col-count">0</span>
                </div>
                <div id="boardTodo" class="board-col-body"></div>
              </div>
              <div class="board-col">
                <div class="board-col-header" style="border-top-color:#C8694A;">
                  <span class="board-col-dot" style="background:#C8694A;"></span>
                  <span class="board-col-title">In Progress</span>
                  <span id="boardProgressCount" class="board-col-count">0</span>
                </div>
                <div id="boardInProgress" class="board-col-body">
                  <p class="text-xs text-center py-6" style="color:#81766C;">
                    Mark tasks active to see them here.
                  </p>
                </div>
              </div>
              <div class="board-col">
                <div class="board-col-header" style="border-top-color:#536B55;">
                  <span class="board-col-dot" style="background:#536B55;"></span>
                  <span class="board-col-title">Done</span>
                  <span id="boardDoneCount" class="board-col-count">0</span>
                </div>
                <div id="boardDone" class="board-col-body"></div>
              </div>
            </div>
          </section>

          <!-- ══════════════════════════════════════════════
               PLACEHOLDER SECTIONS (Household)
          ══════════════════════════════════════════════ -->
          <section id="section-birthdays"   class="section-page hidden"><div class="placeholder-section" data-icon="🎂" data-title="Birthdays"    data-desc="Track family birthdays and special celebrations."></div></section>
          <section id="section-contacts"    class="section-page hidden"><div class="placeholder-section" data-icon="👥" data-title="Contacts"     data-desc="Store family contacts and emergency numbers."></div></section>
          <section id="section-budget"      class="section-page hidden"><div class="placeholder-section" data-icon="💰" data-title="Budget"       data-desc="Track household expenses and savings goals."></div></section>
          <section id="section-documents"   class="section-page hidden"><div class="placeholder-section" data-icon="📄" data-title="Documents"    data-desc="Store important family documents securely."></div></section>
          <section id="section-housekeeping"class="section-page hidden"><div class="placeholder-section" data-icon="🏠" data-title="Housekeeping" data-desc="Schedule cleaning, repairs, and home maintenance."></div></section>
          <section id="section-kitchen"     class="section-page hidden"><div class="placeholder-section" data-icon="🍳" data-title="Kitchen"      data-desc="Plan meals, recipes, and grocery lists."></div></section>

        </div><!-- /main-content -->
      </div><!-- /main-area -->
    </div><!-- /app-shell -->

    <script src="script.js"></script>
  </body>
</html>
